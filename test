import tkinter as tk
import matplotlib.pyplot as plt
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg

# Erstellen des Hauptfensters
root = tk.Tk()
root.title("Hallo Welt mit Matplotlib und Tkinter")

# Erstellen eines einfachen Diagramms mit Matplotlib
fig, ax = plt.subplots()
ax.plot([1, 2, 3, 4], [1, 4, 9, 16], label="Quadratische Funktion")
ax.set_xlabel('X-Achse')
ax.set_ylabel('Y-Achse')
ax.set_title('Ein einfaches Diagramm')

# Canvas erstellen, um das Diagramm in Tkinter anzuzeigen
canvas = FigureCanvasTkAgg(fig, master=root)  
canvas.draw()

# Das Diagramm in das Tkinter-Fenster einfügen
canvas.get_tk_widget().pack()

# Ein Label mit "Hallo Welt" in Tkinter hinzufügen
label = tk.Label(root, text="Hallo Welt!", font=("Helvetica", 16))
label.pack()

# Tkinter-Event-Schleife starten
root.mainloop()
